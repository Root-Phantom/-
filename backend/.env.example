# ============ تنظیمات سامانه مدیریت معابر پلدختر ============
# این فایل را به نام .env کپی کنید و مقادیر را ویرایش کنید.

APP_ENV=production
DEBUG=false

# --- پایگاه داده (کاربر، گذرواژه، میزبان، پورت، نام پایگاه داده) ---
DATABASE_URL=postgresql+psycopg://pol_user:CHANGE_ME@localhost:5432/poldokhtar_gis

# --- کلید امنیتی: با دستور زیر یک مقدار تصادفی بسازید ---
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-GENERATE-A-RANDOM-KEY

# مدت اعتبار نشست به دقیقه (۷۲۰ = ۱۲ ساعت)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# اگر سامانه روی HTTPS اجرا می‌شود این مقدار را true کنید
COOKIE_SECURE=false

# اگر سامانه پشت IIS (ARR) اجرا می‌شود true کنید تا IP واقعی کاربران در لاگ ثبت شود.
# اگر پورت سامانه مستقیماً در شبکه باز است false بماند.
TRUST_PROXY_HEADERS=false

# --- مدیر اولیه: فقط در نخستین اجرا ساخته می‌شود ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_FULLNAME=مدیر سامانه

# --- دامنه‌های مجاز (با کاما جدا کنید) ---
# در حالت تولید که رابط کاربری از همین سرور سرو می‌شود، نیازی به تغییر نیست.
CORS_ORIGINS=http://localhost:5173

# --- حداکثر حجم آپلود شیپ‌فایل به مگابایت ---
MAX_UPLOAD_MB=200
