<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the Poldokhtar Street Management System.
  Requires: IIS URL Rewrite 2.1 + Application Request Routing (ARR) 3.0 with proxy enabled.
  The Python service must listen on 127.0.0.1:8000 (install-service.ps1 -BindAddress 127.0.0.1).
  See docs\DEPLOY.md, section 11.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- redirect HTTP to HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to PoldokhtarGIS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- 200 MB, same as MAX_UPLOAD_MB -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- compression is done by the application -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
