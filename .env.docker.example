# ============ تنظیمات Docker Compose — سامانه مدیریت معابر ویسیان ============
# این فایل را به نام .env (در همین پوشه، کنار docker-compose.yml) کپی کنید و مقادیر را ویرایش کنید.
#   cp .env.docker.example .env

# --- میرورهای ایرانی برای دریافت ایمیج‌ها بدون تحریم و فیلتر ---
# نمونه‌های معتبر: docker.iranserver.com/ یا registry.docker.ir/ یا focker.ir/ (برای دانلود مستقیم از داکر هاب مقدار را خالی بگذارید)
DOCKER_REGISTRY_MIRROR=docker.iranserver.com/

# --- پورت‌های سامانه روی هاست (بازه 7000 تا 7003) ---
# 7000: وب سامانه و API
# 7001: پایگاه داده PostGIS
# 7002: پورت سرور توسعه فرانت‌اند (Vite)
# 7003: پورت رزرو برای ابزارهای جانبی یا مانیتورینگ
APP_PORT=7000
DB_PORT=7001

# --- پایگاه داده ---
DB_USER=veysian_user
DB_PASSWORD=CHANGE_ME
DB_NAME=veysian_gis

# --- کلید امنیتی: با دستور زیر یک مقدار تصادفی بسازید ---
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-GENERATE-A-RANDOM-KEY

# مدت اعتبار نشست به دقیقه (۷۲۰ = ۱۲ ساعت)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# اگر سامانه پشت یک پروکسی معکوس با HTTPS اجرا می‌شود (مثلاً Nginx/Caddy جلوی این سرویس) این دو را true کنید
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# --- مدیر اولیه: فقط در نخستین اجرا ساخته می‌شود ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME
FIRST_ADMIN_FULLNAME=مدیر سامانه

# --- دامنه‌های مجاز اضافی برای CORS (با کاما جدا کنید) ---
# برای اجرای توسعه فرانت‌اند روی پورت 7002 یا دسترسی لوکال روی پورت 7000:
CORS_ORIGINS=http://localhost:7000,http://127.0.0.1:7000,http://localhost:7002,http://127.0.0.1:7002

# --- حداکثر حجم آپلود شیپ‌فایل به مگابایت ---
MAX_UPLOAD_MB=200
