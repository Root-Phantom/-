# ============ تنظیمات Docker Compose — سامانه مدیریت معابر پلدختر ============
# این فایل را به نام .env (در همین پوشه، کنار docker-compose.yml) کپی کنید و مقادیر را ویرایش کنید.
#   cp .env.docker.example .env

# --- پورت‌های سامانه روی هاست (برای پرهیز از تداخل با سرویس‌های دیگر سرور) ---
APP_PORT=8005
DB_PORT=55432

# --- پایگاه داده ---
DB_USER=pol_user
DB_PASSWORD=CHANGE_ME
DB_NAME=poldokhtar_gis

# --- کلید امنیتی: با دستور زیر یک مقدار تصادفی بسازید ---
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-GENERATE-A-RANDOM-KEY

# مدت اعتبار نشست به دقیقه (۷۲۰ = ۱۲ ساعت)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# اگر سامانه پشت یک پروکسی معکوس با HTTPS اجرا می‌شود (مثلاً Nginx/Caddy جلوی این سرویس) این دو را true کنید
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# --- مدیر اولیه: فقط در نخستین اجرا ساخته می‌شود ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME
FIRST_ADMIN_FULLNAME=مدیر سامانه

# --- دامنه‌های مجاز اضافی برای CORS (با کاما جدا کنید) ---
# برای اجرای توسعه فرانت‌اند روی پورت 8006:
CORS_ORIGINS=http://localhost:8006,http://127.0.0.1:8006

# --- حداکثر حجم آپلود شیپ‌فایل به مگابایت ---
MAX_UPLOAD_MB=200
